#usda 1.0
(
    customLayerData = {
        string plant_role = "The four plant FMUs are shadow predictions, not PhysX actuators"
        string purpose = "Live Isaac/PhysX four-wheel PI control through ovfmi"
        string safety = "Offline simulated hardware only; no ROS or robot actuator connection"
    }
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "FmuModels"
    {
        def FmuInstance "Controller_FL"
        {
            custom bool fmi:enabled = 1
            custom asset fmi:fmu = @../fmus/MolonbotWheelPIController.fmu@

            def FmuConnection "Signals"
            {
                custom rel fmi:targets = </World/ControllerStates/FL>

                def FmuMapping "omega_ref_rad_s"
                {
                    custom token fmi:direction = "input"
                    custom string fmi:fmuAttribute = "omega_ref_rad_s"
                    custom string fmi:usdAttribute = "molonbot:omega_ref_rad_s"
                    custom int2 fmi:usdMapping = (0, 1)
                }

                def FmuMapping "omega_meas_rad_s"
                {
                    custom token fmi:direction = "input"
                    custom string fmi:fmuAttribute = "omega_meas_rad_s"
                    custom string fmi:usdAttribute = "molonbot:omega_meas_rad_s"
                    custom int2 fmi:usdMapping = (0, 1)
                }

                def FmuMapping "voltage_cmd_V"
                {
                    custom token fmi:direction = "output"
                    custom string fmi:fmuAttribute = "voltage_cmd_V"
                    custom string fmi:usdAttribute = "molonbot:voltage_cmd_V"
                    custom int2 fmi:usdMapping = (0, 1)
                }

                def FmuMapping "error_rad_s"
                {
                    custom token fmi:direction = "output"
                    custom string fmi:fmuAttribute = "error_rad_s"
                    custom string fmi:usdAttribute = "molonbot:error_rad_s"
                    custom int2 fmi:usdMapping = (0, 1)
                }

                def FmuMapping "integral_V"
                {
                    custom token fmi:direction = "output"
                    custom string fmi:fmuAttribute = "integral_V"
                    custom string fmi:usdAttribute = "molonbot:integral_V"
                    custom int2 fmi:usdMapping = (0, 1)
                }
            }
        }

        def FmuInstance "ShadowPlant_FL"
