#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    # Didactic wheel state; this scene does not control or reproduce a physical robot.
    def Xform "WheelState"
    {
        float molonbot:voltage_cmd_V = 0
        float molonbot:voltage_applied_V = 0
        float molonbot:omega_rad_s = 0
        float molonbot:theta_rad = 0
    }

    def FmuInstance "WheelPlant"
    {
        asset fmi:fmu = @../fmus/MolonbotWheelPlant.fmu@
        bool fmi:enabled = true

        def FmuConnection "Signals"
        {
            rel fmi:targets = </World/WheelState>

            def FmuMapping "Command"
            {
                string fmi:fmuAttribute = "voltage_cmd_V"
                string fmi:usdAttribute = "molonbot:voltage_cmd_V"
                token fmi:direction = "input"
                int2 fmi:usdMapping = (0, 1)
            }

            def FmuMapping "AppliedVoltage"
            {
                string fmi:fmuAttribute = "voltage_applied_V"
                string fmi:usdAttribute = "molonbot:voltage_applied_V"
                token fmi:direction = "output"
                int2 fmi:usdMapping = (0, 1)
            }

            def FmuMapping "Omega"
            {
                string fmi:fmuAttribute = "omega_rad_s"
                string fmi:usdAttribute = "molonbot:omega_rad_s"
                token fmi:direction = "output"
                int2 fmi:usdMapping = (0, 1)
            }

            def FmuMapping "Theta"
            {
                string fmi:fmuAttribute = "theta_rad"
                string fmi:usdAttribute = "molonbot:theta_rad"
                token fmi:direction = "output"
                int2 fmi:usdMapping = (0, 1)
            }
        }
    }
}
